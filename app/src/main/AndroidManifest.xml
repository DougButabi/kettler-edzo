<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Kerékpár: GPS, előtérszolgáltatás helyhez, értesítés a tekerés közbeni adatokkal -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wifi-zárolás: edzés közben ne aludjon el a wifi (ESP-kapcsolat) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Frissítés az appon belül (Beállítások › Névjegy) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Pulzusmérő pánt (Bluetooth LE). Android 12 alatt a kereséshez helyengedély kell (az már megvan). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- A rutinhoz: a telepített appok listája (melyiket indítsa) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Az ESP32 sima http-n beszél, ezért kell a titkosítatlan forgalom. -->
    <application
        android:label="Kettler edző"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".ProfileActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Első indítás: bejelentkezés a ULC-be és az eszköz típusa -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- adjustPan: a billentyűzet felett mindig látszik a szerkesztett mező -->
        <activity
            android:name=".ProfileEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name=".ModeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name=".GoalsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name=".RoutineActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name=".HrActivity"
            android:exported="false" />

        <activity
            android:name=".LogActivity"
            android:exported="false" />

        <activity
            android:name=".SportActivity"
            android:exported="false" />

        <activity
            android:name=".WeightsActivity"
            android:exported="false" />

        <activity
            android:name=".PlanDayActivity"
            android:exported="false" />

        <activity
            android:name=".LiftActivity"
            android:exported="false" />

        <activity
            android:name=".CatalogEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name=".BikeActivity"
            android:exported="false" />

        <activity
            android:name=".RideActivity"
            android:exported="false" />

        <activity
            android:name=".TrackActivity"
            android:exported="false" />

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <service
            android:name=".BikeService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".WorkoutService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Edzésadatok megjelenítése más appok fölött" />
        </service>
    </application>
</manifest>
